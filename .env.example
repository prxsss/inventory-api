# Production datasource only
# For local development, configure the datasource in
# src/main/resources/application-dev.properties using
# src/main/resources/application-dev.properties.example as the template.
DB_URL=jdbc:postgresql://localhost:5432/inventory_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# PostgreSQL Docker initialization (development only)
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000
